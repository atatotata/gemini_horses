  },
  "m_Name": "storyrace_020290011",
  "textData": [
    {
      "key": 1,
      "cueName": "snd_voi_storyrace_020290011_00",
      "typeId": 0,
      "typeParam": 0,
      "text": "レースは後半に入りました、熱気に包まれる『有馬記念』！"
    },
    {
      "key": 2,
      "cueName": "snd_voi_storyrace_020290011_01",
      "typeId": 0,
      "typeParam": 0,
      "text": "ここ数戦、苦戦の続くオグリキャップは\\n現在6～7番手でレースを進めていきます！"
    },
    {
      "key": 3,
      "cueName": "snd_voi_storyrace_020290011_03",
      "typeId": 0,
      "typeParam": 0,
      "text": "まもなく第3コーナー、後方集団も一気に差を詰めてきましたっ！\\nここから最後の力比べっ！"
    },
    {
      "key": 4,
      "cueName": "snd_voi_storyrace_020290011_04",
      "typeId": 2,
      "typeParam": 1,
      "text": "オグリ、いけー！"
    },
    {
      "key": 5,
      "cueName": "snd_voi_storyrace_020290011_05",
      "typeId": 2,
      "typeParam": 2,
      "text": "頑張れ、オグリー！！！"
    },
    {
      "key": 6,
      "cueName": "snd_voi_storyrace_020290011_06",
      "typeId": 1,
      "typeParam": 1006,
      "text": "みんなの期待を力に……"
    },
    {
      "key": 7,
      "cueName": "snd_voi_storyrace_020290011_07",
      "typeId": 1,
      "typeParam": 1006,
      "text": "いくぞ……っ！"
    },
    {
      "key": 8,
      "cueName": "snd_voi_storyrace_020290011_08",
      "typeId": 0,
      "typeParam": 0,
      "text": "オグリが来たっ！　オグリが上がってきた！\\n第4コーナーをまわって、最後の直線！！"
    },
    {
      "key": 9,
      "cueName": "snd_voi_storyrace_020290011_09",
      "typeId": 1,
      "typeParam": 1006,
      "text": "はああああぁぁぁぁ～～～～っ！！！！"
    },
    {
      "key": 10,
      "cueName": "snd_voi_storyrace_020290011_10",
      "typeId": 0,
      "typeParam": 0,
      "text": "オグリ先頭！　オグリが先頭に立った！"
    },
    {
      "key": 11,
      "cueName": "snd_voi_storyrace_020290011_11",
      "typeId": 0,
      "typeParam": 0,
      "text": "しかし外からメジロライアン！　メジロライアンが迫ってくる！"
    },
    {
      "key": 12,
      "cueName": "snd_voi_storyrace_020290011_13",
      "typeId": 0,
      "typeParam": 0,
      "text": "ゴールまで残り200mっ！"
    },
    {
      "key": 13,
      "cueName": "snd_voi_storyrace_020290011_adE",
      "typeId": 1,
      "typeParam": 1006,
      "text": "フッー！"
    },
    {
      "key": 14,
      "cueName": "snd_voi_storyrace_020290011_14",
      "typeId": 0,
      "typeParam": 0,
      "text": "オグリキャップ、ラストランで奇跡を見せるのかーーっ！？"
    }
  ]
}