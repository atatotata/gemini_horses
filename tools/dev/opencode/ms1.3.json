{
  "npm": "@ai-sdk/openai-compatible",
  "api": "https://opencode.ai/zen/go/v1",
  "env": [
    "OPENCODE_API_KEY"
  ],
  "nModels": 35,
  "model": {
    "id": "muse-spark-1.3-contributor",
    "limit": {
      "context": 1048576,
      "output": 131072
    },
    "reasoning": true,
    "modalities": {
      "input": [
        "text",
        "image",
        "video",
        "pdf",
        "audio"
      ],
      "output": [
        "text"
      ]
    },
    "description": "Muse Spark 1.3 is a multimodal reasoning model from Meta for coding and agentic workflows."
  }
}